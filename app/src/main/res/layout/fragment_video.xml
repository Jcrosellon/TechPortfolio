<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tp_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
         android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:text="Presentación en video"
             android:textColor="@color/tp_text_primary"
             android:textSize="28sp"
             android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:layout_marginTop="2dp"
             android:text="Reproductor con controles básicos de reproducción."
             android:textColor="@color/tp_text_secondary"
             android:textSize="16sp" />

         <FrameLayout
             android:id="@+id/videoPlayerContainer"
             android:layout_width="match_parent"
             android:layout_height="220dp"
             android:layout_marginTop="22dp"
             android:background="#101722"
             android:clipToOutline="true">

                <VideoView
                 android:id="@+id/videoView"
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:keepScreenOn="true" />

             <ProgressBar
                 android:id="@+id/videoProgress"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:indeterminateTint="@color/tp_blue" />

             <ImageButton
                 android:id="@+id/btnVideoFullscreen"
                 android:layout_width="40dp"
                 android:layout_height="40dp"
                 android:layout_gravity="top|end"
                 android:layout_marginTop="12dp"
                 android:layout_marginEnd="12dp"
                 android:background="@android:color/transparent"
                 android:contentDescription="Ampliar reproductor"
                 android:padding="8dp"
                  android:src="@android:drawable/ic_menu_zoom"
                 android:tint="@color/white" />

             <LinearLayout
                 android:id="@+id/videoCenterControls"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:gravity="center"
                 android:orientation="vertical">

                 <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="TechPortfolio"
                     android:textColor="#C8D2E2"
                     android:textSize="24sp"
                     android:textStyle="bold" />

                 <ImageButton
                     android:id="@+id/btnVideoPlay"
                     android:layout_width="96dp"
                     android:layout_height="96dp"
                     android:layout_marginTop="18dp"
                      android:background="@color/white"
                     android:contentDescription="Reproducir video"
                     android:padding="28dp"
                      android:src="@android:drawable/ic_media_play"
                     android:tint="@color/tp_blue" />

             </LinearLayout>

             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="48dp"
                 android:layout_gravity="bottom"
                 android:layout_marginStart="28dp"
                 android:layout_marginEnd="28dp"
                 android:layout_marginBottom="24dp"
                  android:background="#1B2738"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:paddingStart="8dp"
                 android:paddingEnd="8dp">

                 <ImageButton
                     android:id="@+id/btnVideoMiniPlay"
                     android:layout_width="36dp"
                     android:layout_height="36dp"
                     android:background="@android:color/transparent"
                     android:contentDescription="Reproducir video"
                     android:padding="8dp"
                      android:src="@android:drawable/ic_media_play"
                     android:tint="@color/white" />

                 <SeekBar
                     android:id="@+id/videoSeekBar"
                     android:layout_width="0dp"
                     android:layout_height="wrap_content"
                     android:layout_weight="1"
                     android:enabled="false"
                     android:max="1000"
                     android:progress="0"
                     android:progressTint="@color/tp_blue"
                     android:thumbTint="@color/white" />

                 <TextView
                     android:id="@+id/tvVideoTime"
                     android:layout_width="52dp"
                     android:layout_height="wrap_content"
                     android:gravity="center"
                     android:text="00:00"
                     android:textColor="@color/white"
                     android:textSize="12sp" />

             </LinearLayout>

             <TextView
                 android:id="@+id/tvVideoError"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:gravity="center"
                 android:padding="16dp"
                 android:text="No se pudo cargar el video"
                 android:textColor="@color/white"
                 android:textSize="14sp"
                 android:visibility="gone" />

          </FrameLayout>

         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="22dp"
             android:layout_marginBottom="4dp"
             android:background="@drawable/bg_card"
             android:orientation="vertical"
             android:padding="20dp">

             <TextView
                 android:id="@+id/tvDescripcionVideo"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:text="Video de presentación donde se describen conocimientos, experiencia, habilidades y proyectos desarrollados."
                 android:textColor="@color/tp_text_secondary"
                 android:textSize="14sp" />

         </LinearLayout>

    </LinearLayout>

</ScrollView>
