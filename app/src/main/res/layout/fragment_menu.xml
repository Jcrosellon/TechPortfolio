<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tp_surface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMenuTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="NAVEGACIÓN"
            android:textColor="@color/tp_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnPerfil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/tp_blue_light"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:contentDescription="Perfil"
            android:text="Perfil"
            android:textAllCaps="false"
            android:textColor="@color/tp_blue"
            android:textSize="12sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iconPerfil"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@android:drawable/ic_menu_myplaces"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnFotos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:contentDescription="Fotos"
            android:text="Fotos"
            android:textAllCaps="false"
            android:textColor="@color/tp_text_primary"
            android:textSize="12sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iconFotos"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@android:drawable/ic_menu_gallery"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:contentDescription="Video"
            android:text="Video"
            android:textAllCaps="false"
            android:textColor="@color/tp_text_primary"
            android:textSize="12sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iconVideo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@android:drawable/ic_media_play"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:contentDescription="Web"
            android:text="Web"
            android:textAllCaps="false"
            android:textColor="@color/tp_text_primary"
            android:textSize="12sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iconWeb"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@android:drawable/ic_menu_view"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="0dp">

        <Button
            android:id="@+id/btnBotones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/white"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:contentDescription="Botones"
            android:text="Botones"
            android:textAllCaps="false"
            android:textColor="@color/tp_text_primary"
            android:textSize="12sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iconBotones"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
